# ─────────────────────────────────────────────
# Toutes les variables NEXT_PUBLIC_* sont figées AU BUILD.
# En Docker : les passer en --build-arg (cf. Dockerfile).
# ─────────────────────────────────────────────

# URL du backend Medusa
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Clé publiable Medusa (Admin → Paramètres → Canaux de vente).
# Requise : le build échoue si elle est absente.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_VOTRE_CLE_ICI

# URL publique du storefront (redirects, SEO)
NEXT_PUBLIC_STORE_URL=http://localhost:3000

# Origine du stockage des images produit (MinIO en local, R2/S3 en prod).
# Sert aux domaines autorisés de next/image et à la CSP.
NEXT_PUBLIC_ASSET_HOST=http://localhost:9002

# ─────────────────────────────────────────────
# Stripe — clé PUBLIABLE uniquement (pk_test_… / pk_live_…)
# Laisser vide : le checkout bascule en paiement manuel (test).
# Renseigner ici + STRIPE_SECRET_KEY côté backend/.env pour activer
# le paiement par carte (Stripe Elements, 3D Secure).
# ─────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
